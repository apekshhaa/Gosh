NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/gosh_marketplace
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/gosh_marketplace_test
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SELLER_AGREEMENT_VERSION=v1
PAYMENT_PROVIDER=disabled
CASHFREE_APP_ID=replace-after-provider-approval
CASHFREE_SECRET_KEY=replace-after-provider-approval
CASHFREE_WEBHOOK_SECRET=replace-after-provider-approval
CASHFREE_NOTIFY_URL=https://your-api.example.com/api/v1/payments/webhooks/cashfree
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_SANDBOX_ENABLED=false
